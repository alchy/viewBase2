# --- co se nikdy nesmí dostat do gitu -------------------------------------
# Logy: od verze s auditem shellu obsahují i to, co kdo napsal do terminálu
# (tedy i heslo napsané na výzvu `sudo`, viz docs/zabezpeceni.md).
*.log
logs/

# Stav instance. Normálně leží v ~/.viewbase, ale VIEWBASE_HOME se dá
# nasměrovat kamkoli – včetně klonu, typicky u kontejnerů a testů.
.viewbase/
users.json
onetime-*.txt
totp-*.svg
totp-*.txt

# Certifikáty a klíče (self-signed z `tls=True` i vlastní).
*.pem
*.key
*.crt
*.p12
*.pfx

# Konfigurace prostředí – bývá v ní, co má zůstat doma.
.env
.env.*
!.env.example

# --- build a nástroje -----------------------------------------------------
**/__pycache__
*.py[cod]
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

.venv
venv/
node_modules/

# --- editory a OS ---------------------------------------------------------
.claude
.idea/
.vscode/
.DS_Store
